\label{tab:fmnist_results}
\begin{tabular}{r|r|r|r|r}
\hline
$N$ & $\alpha$ & Student & Best T & Avg T  \\
\hline
1  & ---   & 63.3 & 87.0 & 87.0 \\
\hline
2  & 0.1   & 41.0 & 68.5 & 51.4 \\
2  & 0.5   & 42.8 & 75.9 & 60.3 \\
2  & 1.0   & 43.3 & 79.5 & 73.2 \\
2  & 100   & 49.5 & 83.4 & 83.1 \\
\hline
4  & 0.1   & 25.5 & 43.1 & 33.5 \\
4  & 0.5   & 35.5 & 61.5 & 53.5 \\
