$N{=}16, \alpha{=}0.5$ & .51 & .49 & .50 & .48 & .51 & .49 & .48 & .50 \\
$N{=}16, \alpha{=}1.0$ & .52 & .48 & .53 & .48 & .53 & .49 & .54 & .50 \\
\hline
\hline
 & \multicolumn{2}{c|}{\textbf{DP-SGD $\epsilon{=}1$}} & \multicolumn{2}{c|}{\textbf{DP-SGD $\epsilon{=}0.1$}} & \multicolumn{2}{c|}{\textbf{DP-SGD $\epsilon{=}0.01$}} & \multicolumn{2}{c}{} \\
