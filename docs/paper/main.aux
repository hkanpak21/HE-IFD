\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces HE-IFD. Each client holds private data $\mathcal  {D}_j$ and trains a local teacher $t_j$. In Phase~0 the clients exchange per-class feature prototypes over peer-to-peer channels, with the server excluded, to agree on a shared loss basin $\theta _0$. Each client then distils its teacher into the shared head for a bounded number of steps and encrypts the resulting displacement $\Delta _j$. The server's sole operation is the sample-weighted linear combination $\theta ^\star =\theta _0+\DOTSB \sum@ \slimits@ _j w_j\Delta _j$ under multiparty CKKS (additions and public-scalar multiplications only; multiplicative depth one); it never decrypts. A threshold of clients jointly decrypts the global model $\theta ^\star $.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:protocol}{{1}{5}{HE-IFD. Each client holds private data $\mathcal {D}_j$ and trains a local teacher $t_j$. In Phase~0 the clients exchange per-class feature prototypes over peer-to-peer channels, with the server excluded, to agree on a shared loss basin $\theta _0$. Each client then distils its teacher into the shared head for a bounded number of steps and encrypts the resulting displacement $\Delta _j$. The server's sole operation is the sample-weighted linear combination $\theta ^\star =\theta _0+\sum _j w_j\Delta _j$ under multiparty CKKS (additions and public-scalar multiplications only; multiplicative depth one); it never decrypts. A threshold of clients jointly decrypts the global model $\theta ^\star $}{figure.1}{}}
\newlabel{fig:protocol@cref}{{[figure][1][]1}{[1][4][]5}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Step-by-step view of the protocol. Steps 1--3 run among the clients without the server; the displacements are encrypted (step~4) and the server's single operation is the linear combination of step~5, which it performs without being able to decrypt; the global model is recovered only by a quorum of clients (step~7).}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:protocol-steps}{{2}{5}{Step-by-step view of the protocol. Steps 1--3 run among the clients without the server; the displacements are encrypted (step~4) and the server's single operation is the linear combination of step~5, which it performs without being able to decrypt; the global model is recovered only by a quorum of clients (step~7)}{figure.2}{}}
\newlabel{fig:protocol-steps@cref}{{[figure][2][]2}{[1][4][]5}{}{}{}}
\@writefile{loa}{\contentsline {algorithm}{\numberline {1}{\ignorespaces One-shot federated distillation with encrypted aggregation. $\mathsf  {Enc}(\cdot )$ denotes encryption under the clients' collective CKKS key.}}{5}{algorithm.1}\protected@file@percent }
\newlabel{alg:protocol}{{1}{5}{Setting and Overview}{algorithm.1}{}}
