        <mxCell id="clnote" value="The backbone and the adapter are the client's own,&#xa;so the serving party never sees the feature vector&#xa;and cannot invert it to recover the query." style="text;html=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=14;fontStyle=2;fontColor=#A8905F;" vertex="1" parent="1">
