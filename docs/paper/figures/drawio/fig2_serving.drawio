          <mxGeometry x="74" y="36" width="128" height="30" as="geometry" />
        </mxCell>
        <mxCell id="clb" value="frozen public backbone&#xa;and the client's own adapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4C5A9;strokeColor=#A8905F;fontFamily=Times New Roman;fontSize=15;fontColor=#3A3A3A;" vertex="1" parent="cl">
